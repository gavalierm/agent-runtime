#!/bin/bash
# Pred pushom prejde súbory repa (lib/public_check.mjs) a meno autora a správy
# commitov, ktoré idú von, a obsah súborov v týchto commitoch (nie pracovný strom). Zapnutie: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node lib/public_check.mjs || exit 1
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
    node lib/public_check.mjs --commits "$range" || exit 1
    # obsah commitov: nová vetva = commity, ktoré nie sú na žiadnom vzdialenom refe
    if [ "$remote_sha" = "$zero" ]; then
        node lib/public_check.mjs --blobs "$local_sha" --not --remotes || exit 1
    else
        node lib/public_check.mjs --blobs "$range" || exit 1
    fi
done
