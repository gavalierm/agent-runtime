# Príklad konfigurácie servera. Skutočný súbor je
# <spoločný mozog>/env/server/config.env (AGENT_BRAIN_GLOBAL), nie tento repo:
# nesie mená a adresy nasadenia. Číta ho env/server/install.sh, formát je
# shell (KEY=hodnota), bez medzier okolo =.

# Používateľ, pod ktorým bežia behy správcu úloh (vlastný ~/.claude a domov).
# Prázdny alebo chýbajúci: install.sh nastavuje len root.
RUNS_USER=tasker-svc

# E-mail autora commitov (git config --global user.email).
GIT_EMAIL=agent@example.org

# Koreň stromu, pod ktorým bežia agenti (odkaz CLAUDE.md s pravidlami
# prostredia). Predvolene /root.
ENV_ROOT=/root

# Cesty starých klonov (oddelené medzerou). Odkazy, ktoré do nich ukazujú, a
# importy z nich install.sh odstráni.
LEGACY_PATHS="/opt/old-rules /opt/old-runtime"

# Staré jednotky systemd (oddelené medzerou), ktoré install.sh vypne a zmaže.
LEGACY_UNITS="old-rules-sync.timer old-rules-sync.service"
