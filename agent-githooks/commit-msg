#!/bin/bash
# Hook commit-msg repa agenta: bez traileru Co-Authored-By a Claude-Session,
# autor "<Agent> (<stroj>)" s e-mailom, ktorý GitHub priradí k účtu
# operátora (lib/commit_guard.sh). Skript je v nasadenom klone kódu
# (AGENT_WORKFLOW, inak na macOS ~/Work/agentic-workflow, inak /opt/agentic-workflow).
wf="${AGENT_WORKFLOW:-}"
if [ -z "$wf" ]; then
    if [ "$(uname)" = Darwin ]; then wf="$HOME/Work/agentic-workflow"; else wf=/opt/agentic-workflow; fi
fi
guard="$wf/lib/commit_guard.sh"
if [ -f "$guard" ]; then
    exec bash "$guard" "$1"
fi
echo "Varovanie: chýba $guard, kontrola autora a trailerov preskočená." >&2
