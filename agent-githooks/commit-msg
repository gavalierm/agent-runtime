#!/bin/bash
# Hook commit-msg repa agenta: bez traileru Co-Authored-By a Claude-Session,
# autor "<Agent> (<stroj>)" s e-mailom, ktorý GitHub priradí k účtu
# operátora (lib/commit_guard.sh repa pravidiel, 2026-10-19). Skript je v nasadenom klone pravidiel.
guard=/opt/agent-rules/lib/commit_guard.sh
[ -f "$guard" ] || guard="$HOME/Work/agent-rules/lib/commit_guard.sh"
if [ -f "$guard" ]; then
    exec bash "$guard" "$1"
fi
echo "Varovanie: chýba $guard, kontrola autora a trailerov preskočená." >&2
